# /etc/nginx/sites-available/admin.chuong.omniev.tech
# Bài 6 trên production: subdomain admin -> container "React Admin" 127.0.0.1:4000
# Ban đầu chỉ có port 80. Chạy `certbot --nginx -d admin.chuong.omniev.tech --redirect`
# thì certbot tự thêm block 443 + redirect 80 -> 443 vào chính file này.

upstream react_admin {
    zone react_admin 64k;
    server 127.0.0.1:4000;
    keepalive 8;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    listen [::]:80;
    server_name admin.chuong.omniev.tech;

    # (Khuyen nghi) chi cho IP cong ty / VPN:
    # allow 203.0.113.0/24;
    # deny  all;

    location / {
        proxy_pass http://react_admin;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
